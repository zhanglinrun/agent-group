<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linrun.infrastructure.dao.IGroupBuyDiscountDao">

    <resultMap id="GroupBuyDiscountMap" type="com.linrun.infrastructure.po.GroupBuyDiscountPO">
        <id column="id" property="id"/>
        <result column="discount_id" property="discountId"/>
        <result column="discount_name" property="discountName"/>
        <result column="discount_desc" property="discountDesc"/>
        <result column="discount_type" property="discountType"/>
        <result column="market_plan" property="marketPlan"/>
        <result column="market_expr" property="marketExpr"/>
        <result column="tag_id" property="tagId"/>
    </resultMap>

    <select id="queryByDiscountId" resultMap="GroupBuyDiscountMap">
        select id,
               discount_id,
               discount_name,
               discount_desc,
               discount_type,
               market_plan,
               market_expr,
               tag_id
        from group_buy_discount
        where discount_id = #{discountId}
        limit 1
    </select>
</mapper>
