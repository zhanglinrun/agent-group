<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linrun.infrastructure.dao.IAgentFileContentDao">

    <select id="queryExtractedText" resultType="java.lang.String">
        select extracted_text
        from ai_file_info
        where file_id = #{fileId}
        limit 1
    </select>
</mapper>
