<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linrun.infrastructure.dao.IGroupBuyMarketSkuDao">

    <resultMap id="GroupBuyMarketSkuMap" type="com.linrun.infrastructure.po.GroupBuyMarketSkuPO">
        <id column="id" property="id"/>
        <result column="source" property="source"/>
        <result column="channel" property="channel"/>
        <result column="goods_id" property="goodsId"/>
        <result column="goods_name" property="goodsName"/>
        <result column="original_price" property="originalPrice"/>
    </resultMap>

    <select id="queryByGoodsId" resultMap="GroupBuyMarketSkuMap">
        select id,
               source,
               channel,
               goods_id,
               goods_name,
               original_price
        from sku
        where goods_id = #{goodsId}
        order by id desc
        limit 1
    </select>
</mapper>
