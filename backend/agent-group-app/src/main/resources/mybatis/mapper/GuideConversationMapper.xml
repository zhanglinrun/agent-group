<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linrun.infrastructure.dao.IGuideConversationDao">

    <resultMap id="GuideConversationMessageMap" type="com.linrun.infrastructure.po.GuideConversationMessagePO">
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="image_url" property="imageUrl"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insertMessage">
        insert into guide_conversation_memory (
          session_id,
          role,
          content,
          image_url,
          create_time
        ) values (
          #{sessionId},
          #{message.role},
          #{message.content},
          #{message.imageUrl},
          now()
        )
    </insert>

    <select id="queryRecentMessages" resultMap="GuideConversationMessageMap">
        select role,
               content,
               image_url,
               create_time
        from (
            select role,
                   content,
                   image_url,
                   create_time
            from guide_conversation_memory
            where session_id = #{sessionId}
            order by id desc
            limit #{limit}
        ) t
        order by create_time asc
    </select>
</mapper>
