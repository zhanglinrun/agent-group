<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linrun.infrastructure.dao.ISourceChannelSkuActivityDao">

    <resultMap id="SourceChannelSkuActivityMap" type="com.linrun.domain.marketing.model.SourceChannelSkuActivity">
        <id column="id" property="id"/>
        <result column="source" property="source"/>
        <result column="channel" property="channel"/>
        <result column="activity_id" property="activityId"/>
        <result column="goods_id" property="goodsId"/>
    </resultMap>

    <select id="queryBySourceChannelGoodsId" resultMap="SourceChannelSkuActivityMap">
        select id,
               source,
               channel,
               activity_id,
               goods_id
        from sc_sku_activity
        where source = #{source}
          and channel = #{channel}
          and goods_id = #{goodsId}
        limit 1
    </select>
</mapper>
